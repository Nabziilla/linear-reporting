# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
#
# Both are optional: the app reads keys from the Settings page (localStorage)
# first and falls back to these. Anything VITE_-prefixed is inlined into the
# client bundle at build time and is therefore readable by anyone with the
# page, so do not use these for a shared deployment.

# Linear personal API key.
# Linear -> Settings -> Security & access -> Personal API keys
VITE_LINEAR_API_KEY=

# Anthropic API key, for the AI chat feature only.
# https://console.anthropic.com -> API Keys
VITE_ANTHROPIC_API_KEY=
