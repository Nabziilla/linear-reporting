# Copy to .env.local and fill in. .env.local is gitignored.
# Optional: the app also lets you paste these in the Settings page (stored in browser localStorage).

# Linear personal API key — create at linear.app -> Settings -> Security & access -> API
VITE_LINEAR_API_KEY=

# Anthropic API key for the AI chat feature (optional)
VITE_ANTHROPIC_API_KEY=
